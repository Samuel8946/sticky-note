<Window x:Class="StickyNoteV2.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Color"
        Width="320" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Preset Colors -->
        <TextBlock Grid.Row="0" Text="Preset Colors" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ItemsControl Grid.Row="1" x:Name="PresetColors" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="32" Height="32" 
                            Margin="2"
                            CornerRadius="4"
                            BorderThickness="2"
                            BorderBrush="Transparent"
                            Background="{Binding}"
                            Cursor="Hand"
                            MouseLeftButtonDown="PresetColor_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#666"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Custom Color -->
        <TextBlock Grid.Row="2" Text="Custom Color" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Red -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Red" VerticalAlignment="Center"/>
            <Slider Grid.Row="0" Grid.Column="1" x:Name="RedSlider" 
                    Width="200" Minimum="0" Maximum="255" 
                    Value="255" ValueChanged="Slider_ValueChanged"/>

            <!-- Green -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Green" VerticalAlignment="Center"/>
            <Slider Grid.Row="1" Grid.Column="1" x:Name="GreenSlider" 
                    Width="200" Minimum="0" Maximum="255" 
                    Value="245" ValueChanged="Slider_ValueChanged"/>

            <!-- Blue -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Blue" VerticalAlignment="Center"/>
            <Slider Grid.Row="2" Grid.Column="1" x:Name="BlueSlider" 
                    Width="200" Minimum="0" Maximum="255" 
                    Value="157" ValueChanged="Slider_ValueChanged"/>
        </Grid>

        <!-- Preview -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border x:Name="ColorPreview" 
                    Height="50" 
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="#CCC"
                    Background="#FFF59D"/>
            <TextBlock x:Name="HexValue" 
                       Text="#FFF59D" 
                       HorizontalAlignment="Center" 
                       Margin="0,8,0,0"
                       FontFamily="Consolas"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK" Width="80" IsDefault="True" Click="OK_Click"/>
        </StackPanel>
    </Grid>
</Window>
