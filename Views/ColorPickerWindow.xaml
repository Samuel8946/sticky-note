<Window x:Class="StickyNoteV2.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Color"
        Width="420" Height="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#E0E0E0">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Choose Color" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#333"
                               VerticalAlignment="Center" 
                               Margin="20,0,0,0"/>
                    <Button Content="✕" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Margin="0,0,15,0"
                            Width="30" Height="30"
                            Click="Cancel_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,15">
                <StackPanel>
                    <!-- Color Spectrum -->
                    <TextBlock Text="Color Spectrum" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,10"/>
                    <Border x:Name="ColorSpectrumBorder" 
                            Height="150" 
                            CornerRadius="8" 
                            ClipToBounds="True"
                            Cursor="Cross"
                            MouseLeftButtonDown="ColorSpectrum_MouseDown"
                            MouseMove="ColorSpectrum_MouseMove"
                            MouseLeftButtonUp="ColorSpectrum_MouseUp">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0000" Offset="0"/>
                                <GradientStop Color="#FFFF00" Offset="0.167"/>
                                <GradientStop Color="#00FF00" Offset="0.333"/>
                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                <GradientStop Color="#0000FF" Offset="0.667"/>
                                <GradientStop Color="#FF00FF" Offset="0.833"/>
                                <GradientStop Color="#FF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Canvas x:Name="SpectrumCanvas">
                                <Ellipse x:Name="SpectrumSelector" 
                                         Width="16" Height="16" 
                                         Stroke="#FFFFFF" StrokeThickness="2"
                                         Fill="Transparent"
                                         IsHitTestVisible="False">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#000" BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Border>
                    </Border>

                    <!-- Preset Colors -->
                    <TextBlock Text="Preset Colors" FontWeight="SemiBold" Foreground="#555" Margin="0,20,0,10"/>
                    <WrapPanel>
                        <Button Style="{StaticResource SwatchButton}" Background="#FF5252" Click="Preset_Click" Tag="#FF5252"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#FF4081" Click="Preset_Click" Tag="#FF4081"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#E040FB" Click="Preset_Click" Tag="#E040FB"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#7C4DFF" Click="Preset_Click" Tag="#7C4DFF"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#536DFE" Click="Preset_Click" Tag="#536DFE"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#448AFF" Click="Preset_Click" Tag="#448AFF"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#40C4FF" Click="Preset_Click" Tag="#40C4FF"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#18FFFF" Click="Preset_Click" Tag="#18FFFF"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#64FFDA" Click="Preset_Click" Tag="#64FFDA"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#69F0AE" Click="Preset_Click" Tag="#69F0AE"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#B2FF59" Click="Preset_Click" Tag="#B2FF59"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#EEFF41" Click="Preset_Click" Tag="#EEFF41"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#FFFF00" Click="Preset_Click" Tag="#FFFF00"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#FFD740" Click="Preset_Click" Tag="#FFD740"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#FFAB40" Click="Preset_Click" Tag="#FFAB40"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#FF6E40" Click="Preset_Click" Tag="#FF6E40"/>
                    </WrapPanel>
                    
                    <!-- Pastel Colors -->
                    <TextBlock Text="Pastel Colors" FontWeight="SemiBold" Foreground="#555" Margin="0,15,0,10"/>
                    <WrapPanel>
                        <Button Style="{StaticResource SwatchButton}" Background="#FFCDD2" Click="Preset_Click" Tag="#FFCDD2"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#F8BBD9" Click="Preset_Click" Tag="#F8BBD9"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#E1BEE7" Click="Preset_Click" Tag="#E1BEE7"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#D1C4E9" Click="Preset_Click" Tag="#D1C4E9"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#C5CAE9" Click="Preset_Click" Tag="#C5CAE9"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#BBDEFB" Click="Preset_Click" Tag="#BBDEFB"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#B3E5FC" Click="Preset_Click" Tag="#B3E5FC"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#B2EBF2" Click="Preset_Click" Tag="#B2EBF2"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#B2DFDB" Click="Preset_Click" Tag="#B2DFDB"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#C8E6C9" Click="Preset_Click" Tag="#C8E6C9"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#DCEDC8" Click="Preset_Click" Tag="#DCEDC8"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#F0F4C3" Click="Preset_Click" Tag="#F0F4C3"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#FFF9C4" Click="Preset_Click" Tag="#FFF9C4"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#FFECB3" Click="Preset_Click" Tag="#FFECB3"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#FFE0B2" Click="Preset_Click" Tag="#FFE0B2"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#FFCCBC" Click="Preset_Click" Tag="#FFCCBC"/>
                    </WrapPanel>

                    <!-- Neutrals -->
                    <TextBlock Text="Neutrals" FontWeight="SemiBold" Foreground="#555" Margin="0,15,0,10"/>
                    <WrapPanel>
                        <Button Style="{StaticResource SwatchButton}" Background="#FFFFFF" Click="Preset_Click" Tag="#FFFFFF"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#FAFAFA" Click="Preset_Click" Tag="#FAFAFA"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#F5F5F5" Click="Preset_Click" Tag="#F5F5F5"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#EEEEEE" Click="Preset_Click" Tag="#EEEEEE"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#E0E0E0" Click="Preset_Click" Tag="#E0E0E0"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#BDBDBD" Click="Preset_Click" Tag="#BDBDBD"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#9E9E9E" Click="Preset_Click" Tag="#9E9E9E"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#757575" Click="Preset_Click" Tag="#757575"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#616161" Click="Preset_Click" Tag="#616161"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#424242" Click="Preset_Click" Tag="#424242"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#212121" Click="Preset_Click" Tag="#212121"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#000000" Click="Preset_Click" Tag="#000000"/>
                    </WrapPanel>

                    <!-- Hex Input -->
                    <TextBlock Text="Hex Color" FontWeight="SemiBold" Foreground="#555" Margin="0,20,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HexInput" 
                                 Grid.Column="0"
                                 Text="#FFF59D"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 Padding="12,10"
                                 BorderThickness="1"
                                 BorderBrush="#E0E0E0"
                                 Background="#FAFAFA"
                                 TextChanged="HexInput_TextChanged"
                                 MaxLength="7">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Border x:Name="PreviewSwatch" 
                                Grid.Column="1" 
                                Background="#FFF59D" 
                                CornerRadius="6" 
                                Margin="10,0,0,0"
                                BorderThickness="1"
                                BorderBrush="#E0E0E0"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                    <Button Content="Cancel" 
                            Width="90" Height="36"
                            Margin="0,0,10,0"
                            Click="Cancel_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#E8E8E8" CornerRadius="6" Padding="15,8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#D8D8D8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Select" 
                            Width="90" Height="36"
                            Click="Select_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#2196F3" CornerRadius="6" Padding="15,8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="White"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <Window.Resources>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="2"
                                BorderBrush="#E8E8E8">
                            <Border.Effect>
                                <DropShadowEffect Color="#000" BlurRadius="3" ShadowDepth="1" Opacity="0.1"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#888"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000" BlurRadius="6" ShadowDepth="2" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
