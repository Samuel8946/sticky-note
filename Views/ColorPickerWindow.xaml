<Window x:Class="StickyNoteV2.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Color"
        Width="360" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#43A047"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#388E3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Swatch Style -->
        <Style x:Key="ColorSwatch" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.15"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Choose Color" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#333"/>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="24,0,24,0">
                
                <!-- Saturation/Brightness Box -->
                <Border x:Name="SatBrightBox" 
                        Height="160" 
                        CornerRadius="12"
                        ClipToBounds="True"
                        MouseDown="SatBright_MouseDown"
                        MouseMove="SatBright_MouseMove"
                        MouseUp="SatBright_MouseUp"
                        Cursor="Cross">
                    <Border.Background>
                        <SolidColorBrush x:Name="SatBrightBackground" Color="#FF0000"/>
                    </Border.Background>
                    <Grid>
                        <!-- White gradient left to right -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Black gradient top to bottom -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Selector circle -->
                        <Canvas>
                            <Ellipse x:Name="SatBrightSelector" 
                                     Width="20" Height="20"
                                     Stroke="White" StrokeThickness="3"
                                     Fill="Transparent">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.5"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Hue Slider -->
                <TextBlock Text="Hue" FontWeight="SemiBold" Foreground="#666" FontSize="12" Margin="0,16,0,8"/>
                <Grid Height="28">
                    <Border CornerRadius="14"
                            ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.15"/>
                        </Border.Effect>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#FF0000" Offset="0"/>
                                <GradientStop Color="#FF8000" Offset="0.083"/>
                                <GradientStop Color="#FFFF00" Offset="0.167"/>
                                <GradientStop Color="#80FF00" Offset="0.25"/>
                                <GradientStop Color="#00FF00" Offset="0.333"/>
                                <GradientStop Color="#00FF80" Offset="0.417"/>
                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                <GradientStop Color="#0080FF" Offset="0.583"/>
                                <GradientStop Color="#0000FF" Offset="0.667"/>
                                <GradientStop Color="#8000FF" Offset="0.75"/>
                                <GradientStop Color="#FF00FF" Offset="0.833"/>
                                <GradientStop Color="#FF0080" Offset="0.917"/>
                                <GradientStop Color="#FF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="HueSlider" 
                            Background="Transparent"
                            MouseDown="Hue_MouseDown"
                            MouseMove="Hue_MouseMove"
                            MouseUp="Hue_MouseUp"
                            Cursor="Hand">
                        <Canvas>
                            <Border x:Name="HueSelector" 
                                    Width="12" Height="32"
                                    Background="White"
                                    CornerRadius="6"
                                    BorderBrush="#CCC" BorderThickness="1"
                                    Canvas.Top="-2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                                </Border.Effect>
                            </Border>
                        </Canvas>
                    </Border>
                </Grid>

                <!-- Color Preview -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Current" FontWeight="SemiBold" Foreground="#666" FontSize="12" Margin="0,0,0,6"/>
                        <Border x:Name="CurrentColorSwatch" 
                                Height="50" CornerRadius="10"
                                Background="#FFF59D">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.15"/>
                            </Border.Effect>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="New" FontWeight="SemiBold" Foreground="#666" FontSize="12" Margin="0,0,0,6"/>
                        <Border x:Name="NewColorSwatch" 
                                Height="50" CornerRadius="10"
                                Background="#FFF59D">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.15"/>
                            </Border.Effect>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Hex Input -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="HEX" FontWeight="SemiBold" Foreground="#666" 
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="HexInput" 
                             Grid.Column="1"
                             Text="#FFF59D"
                             FontFamily="Consolas"
                             FontSize="14"
                             Padding="12,10"
                             Background="#F5F5F5"
                             BorderBrush="Transparent"
                             BorderThickness="0"
                             TextChanged="HexInput_TextChanged">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>

                <!-- Quick Colors -->
                <TextBlock Text="Presets" FontWeight="SemiBold" Foreground="#666" FontSize="12" Margin="0,16,0,8"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Button Style="{StaticResource ColorSwatch}" Background="#FF6B6B" Tag="#FF6B6B" Click="QuickColor_Click"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#FFA94D" Tag="#FFA94D" Click="QuickColor_Click"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#FFE066" Tag="#FFE066" Click="QuickColor_Click"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#69DB7C" Tag="#69DB7C" Click="QuickColor_Click"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#74C0FC" Tag="#74C0FC" Click="QuickColor_Click"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#B197FC" Tag="#B197FC" Click="QuickColor_Click"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#F783AC" Tag="#F783AC" Click="QuickColor_Click"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#FFFFFF" Tag="#FFFFFF" Click="QuickColor_Click"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#868E96" Tag="#868E96" Click="QuickColor_Click"/>
                    <Button Style="{StaticResource ColorSwatch}" Background="#212529" Tag="#212529" Click="QuickColor_Click"/>
                </WrapPanel>
            </StackPanel>

            <!-- Buttons -->
            <Border Grid.Row="2" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancel" Style="{StaticResource ModernButton}" 
                            HorizontalAlignment="Left" Click="Cancel_Click"/>
                    <Button Grid.Column="1" Content="Apply" Style="{StaticResource ModernButton}" 
                            Margin="0,0,10,0" Click="Apply_Click"/>
                    <Button Grid.Column="2" Content="OK" Style="{StaticResource PrimaryButton}" Click="OK_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
