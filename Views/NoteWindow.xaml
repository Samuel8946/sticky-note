<Window x:Class="StickyNoteV2.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StickNote"
        Width="250" Height="250"
        MinWidth="150" MinHeight="100"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="Transparent"
        Opacity="0"
        Icon="/sticky icon.png"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Modern Context Menu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.2"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern MenuItem Style -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Arrow"/>
                                </Grid.ColumnDefinitions>
                                
                                <ContentPresenter x:Name="Icon"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding Icon}"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,4,0"
                                                  Width="16" Height="16"/>
                                
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                                
                                <Path x:Name="Arrow"
                                      Grid.Column="2"
                                      Data="M0,0 L4,4 L0,8"
                                      Fill="#666666"
                                      VerticalAlignment="Center"
                                      Margin="8,0,12,0"
                                      Visibility="Collapsed"/>
                                
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Right"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border Background="#FAFAFA"
                                            BorderBrush="#E0E0E0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.2"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Content">
                                    <Setter.Value>
                                        <TextBlock Text="✓" FontWeight="Bold" Foreground="#333"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separator Style -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="8,4"/>
        </Style>

        <!-- Button Style for Title Bar -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="3"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#30000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Swatch Style -->
        <Style x:Key="ColorSwatch" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="2"
                                BorderBrush="#E0E0E0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.15"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#888"/>
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Border with rounded corners -->
    <Border x:Name="MainBorder" 
            Background="#FFF59D" 
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#40000000">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                              BlurRadius="15" 
                              ShadowDepth="3" 
                              Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" 
                  x:Name="TitleBar" 
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Drag Area -->
                <Border Grid.Column="0" Background="Transparent"/>

                <!-- New Note Button -->
                <Button Grid.Column="1" 
                        Style="{StaticResource TitleBarButton}"
                        Click="NewNote_Click"
                        ToolTip="New Note">
                    <TextBlock Text="+" FontWeight="Bold" FontSize="16"/>
                </Button>

                <!-- Pin Button -->
                <Button Grid.Column="2" 
                        x:Name="PinButton"
                        Style="{StaticResource TitleBarButton}"
                        Click="Pin_Click"
                        ToolTip="Pin on top">
                    <TextBlock x:Name="PinIcon" Text="📌" FontSize="12"/>
                </Button>

                <!-- Close Button -->
                <Button Grid.Column="3" 
                        Style="{StaticResource TitleBarButton}"
                        Click="Close_Click"
                        ToolTip="Delete Note">
                    <TextBlock Text="✕" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- Note Content -->
            <TextBox Grid.Row="1"
                     x:Name="NoteTextBox"
                     Background="Transparent"
                     BorderThickness="0"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="14,4,14,14"
                     FontFamily="Segoe UI"
                     FontSize="14"
                     Foreground="#000000"
                     CaretBrush="#333333"
                     TextChanged="NoteTextBox_TextChanged"/>

            <!-- Context Menu -->
            <Grid.ContextMenu>
                <ContextMenu>
                    <!-- Note Color Section -->
                    <MenuItem Header="🎨  Note Color">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Note Color" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                                        <WrapPanel MaxWidth="220">
                                            <Button Style="{StaticResource ColorSwatch}" Background="#FFF59D" Click="PresetColor_Click" Tag="#FFF59D" ToolTip="Yellow"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#F48FB1" Click="PresetColor_Click" Tag="#F48FB1" ToolTip="Pink"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#90CAF9" Click="PresetColor_Click" Tag="#90CAF9" ToolTip="Blue"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#A5D6A7" Click="PresetColor_Click" Tag="#A5D6A7" ToolTip="Green"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#FFCC80" Click="PresetColor_Click" Tag="#FFCC80" ToolTip="Orange"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#CE93D8" Click="PresetColor_Click" Tag="#CE93D8" ToolTip="Purple"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#FFFFFF" Click="PresetColor_Click" Tag="#FFFFFF" ToolTip="White"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#E0E0E0" Click="PresetColor_Click" Tag="#E0E0E0" ToolTip="Gray"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#FFCDD2" Click="PresetColor_Click" Tag="#FFCDD2" ToolTip="Red"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#B2EBF2" Click="PresetColor_Click" Tag="#B2EBF2" ToolTip="Cyan"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#DCEDC8" Click="PresetColor_Click" Tag="#DCEDC8" ToolTip="Lime"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#D7CCC8" Click="PresetColor_Click" Tag="#D7CCC8" ToolTip="Brown"/>
                                        </WrapPanel>
                                        <Button Content="Custom Color..." 
                                                Click="CustomColor_Click"
                                                Margin="0,10,0,0"
                                                Padding="10,6"
                                                Background="#E8E8E8"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    
                    <Separator/>
                    
                    <!-- Text Color Section -->
                    <MenuItem Header="✏️  Text Color">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Text Color" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                                        <WrapPanel MaxWidth="220">
                                            <Button Style="{StaticResource ColorSwatch}" Background="#000000" Click="FontColor_Click" Tag="#000000" ToolTip="Black"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#333333" Click="FontColor_Click" Tag="#333333" ToolTip="Dark Gray"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#666666" Click="FontColor_Click" Tag="#666666" ToolTip="Gray"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#FFFFFF" Click="FontColor_Click" Tag="#FFFFFF" ToolTip="White"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#D32F2F" Click="FontColor_Click" Tag="#D32F2F" ToolTip="Red"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#1976D2" Click="FontColor_Click" Tag="#1976D2" ToolTip="Blue"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#388E3C" Click="FontColor_Click" Tag="#388E3C" ToolTip="Green"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#7B1FA2" Click="FontColor_Click" Tag="#7B1FA2" ToolTip="Purple"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#F57C00" Click="FontColor_Click" Tag="#F57C00" ToolTip="Orange"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#00796B" Click="FontColor_Click" Tag="#00796B" ToolTip="Teal"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#C2185B" Click="FontColor_Click" Tag="#C2185B" ToolTip="Magenta"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#5D4037" Click="FontColor_Click" Tag="#5D4037" ToolTip="Brown"/>
                                        </WrapPanel>
                                        <Button Content="Custom Color..." 
                                                Click="CustomFontColor_Click"
                                                Margin="0,10,0,0"
                                                Padding="10,6"
                                                Background="#E8E8E8"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    
                    <Separator/>
                    
                    <!-- Font Options -->
                    <MenuItem Header="🔤  Font">
                        <MenuItem Header="Change Font..." Click="ChangeFont_Click"/>
                        <Separator/>
                        <MenuItem Header="Size">
                            <MenuItem Header="Small (10)" Click="FontSize_Click" Tag="10"/>
                            <MenuItem Header="Normal (14)" Click="FontSize_Click" Tag="14"/>
                            <MenuItem Header="Large (18)" Click="FontSize_Click" Tag="18"/>
                            <MenuItem Header="Extra Large (24)" Click="FontSize_Click" Tag="24"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="BoldMenuItem" Header="Bold" IsCheckable="True" Click="Bold_Click"/>
                        <MenuItem x:Name="ItalicMenuItem" Header="Italic" IsCheckable="True" Click="Italic_Click"/>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>
    </Border>
</Window>
