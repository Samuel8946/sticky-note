<Window x:Class="StickyNoteV2.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sticky Note"
        Width="250" Height="250"
        MinWidth="150" MinHeight="100"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="Transparent"
        Opacity="0"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Button Style for Title Bar -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="3"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#30000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Menu Item Style -->
        <Style x:Key="ColorMenuItem" TargetType="MenuItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                Width="24" Height="24"
                                Margin="2"
                                CornerRadius="4"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                Cursor="Hand">
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Border with rounded corners -->
    <Border x:Name="MainBorder" 
            Background="#FFF59D" 
            CornerRadius="4"
            BorderThickness="1"
            BorderBrush="#40000000">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                              BlurRadius="10" 
                              ShadowDepth="2" 
                              Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" 
                  x:Name="TitleBar" 
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Drag Area -->
                <Border Grid.Column="0" Background="Transparent"/>

                <!-- New Note Button -->
                <Button Grid.Column="1" 
                        Style="{StaticResource TitleBarButton}"
                        Click="NewNote_Click"
                        ToolTip="New Note">
                    <TextBlock Text="+" FontWeight="Bold" FontSize="16"/>
                </Button>

                <!-- Pin Button -->
                <Button Grid.Column="2" 
                        x:Name="PinButton"
                        Style="{StaticResource TitleBarButton}"
                        Click="Pin_Click"
                        ToolTip="Pin on top">
                    <TextBlock x:Name="PinIcon" Text="📌" FontSize="12"/>
                </Button>

                <!-- Close Button -->
                <Button Grid.Column="3" 
                        Style="{StaticResource TitleBarButton}"
                        Click="Close_Click"
                        ToolTip="Delete Note">
                    <TextBlock Text="✕" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- Note Content -->
            <TextBox Grid.Row="1"
                     x:Name="NoteTextBox"
                     Background="Transparent"
                     BorderThickness="0"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="12,4,12,12"
                     FontFamily="Segoe UI"
                     FontSize="14"
                     TextChanged="NoteTextBox_TextChanged"/>

            <!-- Context Menu -->
            <Grid.ContextMenu>
                <ContextMenu>
                    <!-- Note Color -->
                    <MenuItem Header="Note Color">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Padding="8,4">
                                    <StackPanel>
                                        <TextBlock Text="Note Color" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <WrapPanel MaxWidth="200">
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#FFF59D" Click="Color_Click" Tag="#FFF59D"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#F48FB1" Click="Color_Click" Tag="#F48FB1"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#90CAF9" Click="Color_Click" Tag="#90CAF9"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#A5D6A7" Click="Color_Click" Tag="#A5D6A7"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#FFCC80" Click="Color_Click" Tag="#FFCC80"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#CE93D8" Click="Color_Click" Tag="#CE93D8"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#EF9A9A" Click="Color_Click" Tag="#EF9A9A"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#80CBC4" Click="Color_Click" Tag="#80CBC4"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#9FA8DA" Click="Color_Click" Tag="#9FA8DA"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#E6EE9C" Click="Color_Click" Tag="#E6EE9C"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#FFE082" Click="Color_Click" Tag="#FFE082"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#80DEEA" Click="Color_Click" Tag="#80DEEA"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#BCAAA4" Click="Color_Click" Tag="#BCAAA4"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#EEEEEE" Click="Color_Click" Tag="#EEEEEE"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#FFFFFF" Click="Color_Click" Tag="#FFFFFF"/>
                                        </WrapPanel>
                                        <Button Content="Custom Color..." Margin="0,8,0,0" Click="CustomColor_Click" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    
                    <!-- Text Color -->
                    <MenuItem Header="Text Color">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Padding="8,4">
                                    <StackPanel>
                                        <TextBlock Text="Text Color" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <WrapPanel MaxWidth="200">
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#000000" Click="TextColor_Click" Tag="#000000"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#333333" Click="TextColor_Click" Tag="#333333"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#666666" Click="TextColor_Click" Tag="#666666"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#999999" Click="TextColor_Click" Tag="#999999"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#FFFFFF" Click="TextColor_Click" Tag="#FFFFFF"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#D32F2F" Click="TextColor_Click" Tag="#D32F2F"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#1976D2" Click="TextColor_Click" Tag="#1976D2"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#388E3C" Click="TextColor_Click" Tag="#388E3C"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#7B1FA2" Click="TextColor_Click" Tag="#7B1FA2"/>
                                            <MenuItem Style="{StaticResource ColorMenuItem}" Background="#F57C00" Click="TextColor_Click" Tag="#F57C00"/>
                                        </WrapPanel>
                                        <Button Content="Custom Color..." Margin="0,8,0,0" Click="CustomTextColor_Click" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    
                    <Separator/>
                    
                    <!-- Font Family -->
                    <MenuItem Header="Font" x:Name="FontFamilyMenu"/>
                    
                    <!-- Font Size -->
                    <MenuItem Header="Size" x:Name="FontSizeMenu"/>
                    
                    <Separator/>
                    
                    <!-- Font Style -->
                    <MenuItem Header="Bold" x:Name="BoldMenuItem" IsCheckable="True" Click="Bold_Click"/>
                    <MenuItem Header="Italic" x:Name="ItalicMenuItem" IsCheckable="True" Click="Italic_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>
    </Border>
</Window>
