<Window x:Class="StickyNoteV2.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sticky Note"
        Width="250" Height="250"
        MinWidth="150" MinHeight="100"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="Transparent"
        Opacity="0"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Button Style for Title Bar -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="3"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#30000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Color Swatch Style -->
        <Style x:Key="ColorSwatch" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderThickness="2"
                                BorderBrush="Transparent">
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Border with rounded corners -->
    <Border x:Name="MainBorder" 
            Background="#FFF59D" 
            CornerRadius="4"
            BorderThickness="1"
            BorderBrush="#40000000">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                              BlurRadius="10" 
                              ShadowDepth="2" 
                              Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" 
                  x:Name="TitleBar" 
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Drag Area -->
                <Border Grid.Column="0" Background="Transparent"/>

                <!-- New Note Button -->
                <Button Grid.Column="1" 
                        Style="{StaticResource TitleBarButton}"
                        Click="NewNote_Click"
                        ToolTip="New Note">
                    <TextBlock Text="+" FontWeight="Bold" FontSize="16"/>
                </Button>

                <!-- Pin Button -->
                <Button Grid.Column="2" 
                        x:Name="PinButton"
                        Style="{StaticResource TitleBarButton}"
                        Click="Pin_Click"
                        ToolTip="Pin on top">
                    <TextBlock x:Name="PinIcon" Text="📌" FontSize="12"/>
                </Button>

                <!-- Close Button -->
                <Button Grid.Column="3" 
                        Style="{StaticResource TitleBarButton}"
                        Click="Close_Click"
                        ToolTip="Delete Note">
                    <TextBlock Text="✕" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- Note Content -->
            <TextBox Grid.Row="1"
                     x:Name="NoteTextBox"
                     Background="Transparent"
                     BorderThickness="0"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="12,4,12,12"
                     FontFamily="Segoe UI"
                     FontSize="14"
                     TextChanged="NoteTextBox_TextChanged"/>

            <!-- Context Menu -->
            <Grid.ContextMenu>
                <ContextMenu>
                    <!-- Preset Colors -->
                    <MenuItem Header="Quick Colors">
                        <MenuItem.Template>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Padding="8,4">
                                    <StackPanel>
                                        <TextBlock Text="Quick Colors" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#FFF59D" Click="PresetColor_Click" Tag="#FFF59D" ToolTip="Yellow"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#F48FB1" Click="PresetColor_Click" Tag="#F48FB1" ToolTip="Pink"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#90CAF9" Click="PresetColor_Click" Tag="#90CAF9" ToolTip="Blue"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#A5D6A7" Click="PresetColor_Click" Tag="#A5D6A7" ToolTip="Green"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#FFCC80" Click="PresetColor_Click" Tag="#FFCC80" ToolTip="Orange"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#CE93D8" Click="PresetColor_Click" Tag="#CE93D8" ToolTip="Purple"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <Button Style="{StaticResource ColorSwatch}" Background="#FFFFFF" Click="PresetColor_Click" Tag="#FFFFFF" ToolTip="White"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#E0E0E0" Click="PresetColor_Click" Tag="#E0E0E0" ToolTip="Gray"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#FFCDD2" Click="PresetColor_Click" Tag="#FFCDD2" ToolTip="Red"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#B2EBF2" Click="PresetColor_Click" Tag="#B2EBF2" ToolTip="Cyan"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#DCEDC8" Click="PresetColor_Click" Tag="#DCEDC8" ToolTip="Lime"/>
                                            <Button Style="{StaticResource ColorSwatch}" Background="#D7CCC8" Click="PresetColor_Click" Tag="#D7CCC8" ToolTip="Brown"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </MenuItem.Template>
                    </MenuItem>
                    
                    <MenuItem Header="Custom Color..." Click="CustomColor_Click"/>
                    
                    <Separator/>
                    
                    <!-- Font Options -->
                    <MenuItem Header="Font">
                        <MenuItem Header="Change Font..." Click="ChangeFont_Click"/>
                        <Separator/>
                        <MenuItem Header="Size">
                            <MenuItem Header="Small (10)" Click="FontSize_Click" Tag="10"/>
                            <MenuItem Header="Normal (14)" Click="FontSize_Click" Tag="14"/>
                            <MenuItem Header="Large (18)" Click="FontSize_Click" Tag="18"/>
                            <MenuItem Header="Extra Large (24)" Click="FontSize_Click" Tag="24"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="BoldMenuItem" Header="Bold" IsCheckable="True" Click="Bold_Click"/>
                        <MenuItem x:Name="ItalicMenuItem" Header="Italic" IsCheckable="True" Click="Italic_Click"/>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>
    </Border>
</Window>
